# The release tag check (DECISIONS Unit 60, RV5): a tag build passes only when the tag is
# "v" + the CMake project version and the checkout has no uncommitted change.
# -DTAG=<tag name> -DROOT=<source directory>; optional -DGIT=<git>. For its tests (XG5) the
# version and the dirty state can be given: -DVERSION=<x.y.z> -DDIRTY=<true|false>.
if(NOT DEFINED TAG OR TAG STREQUAL "")
  message(FATAL_ERROR "no tag given")
endif()
if(NOT DEFINED VERSION)
  file(READ "${ROOT}/CMakeLists.txt" lists)
  if(NOT lists MATCHES "project\\(NiTCAD VERSION ([0-9]+\\.[0-9]+\\.[0-9]+)")
    message(FATAL_ERROR "no project version in ${ROOT}/CMakeLists.txt")
  endif()
  set(VERSION "${CMAKE_MATCH_1}")
endif()
if(NOT DEFINED DIRTY)
  if(NOT DEFINED GIT)
    set(GIT git)
  endif()
  execute_process(COMMAND "${GIT}" -C "${ROOT}" status --porcelain
                  RESULT_VARIABLE rc OUTPUT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "git status failed (${rc})")
  endif()
  if(status STREQUAL "")
    set(DIRTY false)
  else()
    set(DIRTY true)
  endif()
endif()
if(NOT TAG STREQUAL "v${VERSION}")
  message(FATAL_ERROR "tag '${TAG}' does not name version ${VERSION} (expected 'v${VERSION}')")
endif()
if(DIRTY)
  message(FATAL_ERROR "the checkout has uncommitted changes; a release is built from a clean tree")
endif()
message("release tag ${TAG} matches version ${VERSION}")
