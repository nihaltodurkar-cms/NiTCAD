# TVD-19 / VR2 (Unit 55, TVR-1): a verify library includes only the layers its row of DECISIONS 11.2
# allows. Run as
#   cmake -DROOT=<source dir> -DLAYER=<reference|consistency|...> -DALLOWED=<prefix;...> [-DSTAMP=<file>] -P boundary.cmake
# Every file under include/NiTCAD/verify/<LAYER> and src/verify/<LAYER> is scanned: a quoted or angled
# include of NiTCAD/<path> must start with one of the ALLOWED prefixes (for example verify/reference or
# base), and no file may include Eigen or Catch2. The build runs this before compiling the library (so a
# forbidden include fails the build, VR2), and ctest runs it again. STAMP, when given, is written on success.
if(NOT DEFINED ROOT OR NOT DEFINED LAYER OR NOT DEFINED ALLOWED)
  message(FATAL_ERROR "boundary.cmake needs ROOT, LAYER and ALLOWED")
endif()
string(REPLACE "," ";" ALLOWED "${ALLOWED}")
file(GLOB_RECURSE sources "${ROOT}/include/NiTCAD/verify/${LAYER}/*" "${ROOT}/src/verify/${LAYER}/*")
list(LENGTH sources count)
if(count EQUAL 0)
  message(FATAL_ERROR "no verify/${LAYER} sources found under ${ROOT}")
endif()
set(bad "")
foreach(f IN LISTS sources)
  file(STRINGS "${f}" lines REGEX "^[ \t]*#[ \t]*include[ \t]*[\"<]")
  foreach(line IN LISTS lines)
    string(REGEX MATCH "[\"<]([^\">]+)[\">]" m "${line}")
    set(path "${CMAKE_MATCH_1}")
    if(path MATCHES "^(Eigen|eigen3|unsupported/Eigen|catch2)/")
      list(APPEND bad "${f}: ${line}")
    elseif(path MATCHES "^NiTCAD/(.+)$")
      set(rest "${CMAKE_MATCH_1}")
      set(ok FALSE)
      foreach(prefix IN LISTS ALLOWED)
        string(LENGTH "${prefix}/" plen)
        string(SUBSTRING "${rest}" 0 ${plen} head)
        if(head STREQUAL "${prefix}/")
          set(ok TRUE)
        endif()
      endforeach()
      if(NOT ok)
        list(APPEND bad "${f}: ${line}")
      endif()
    endif()
  endforeach()
endforeach()
if(bad)
  string(REPLACE ";" "\n" bad "${bad}")
  message(FATAL_ERROR "verify/${LAYER} includes outside its allowed layers (${ALLOWED}):\n${bad}")
endif()
if(DEFINED STAMP)
  file(WRITE "${STAMP}" "verify/${LAYER}: ${count} files within ${ALLOWED}\n")
endif()
message(STATUS "verify/${LAYER} boundary: ${count} files, includes within ${ALLOWED}")
