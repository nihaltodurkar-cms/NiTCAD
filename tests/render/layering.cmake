# VG1 (Unit 25a): render includes only the layers it may depend on (ARCHITECTURE.md 3, amended by
# VQ8): base, mesh, results, analysis and device. Run as `cmake -DROOT=<source dir> -P layering.cmake`.
set(allowed base mesh results analysis device render)
file(GLOB_RECURSE sources "${ROOT}/include/NiTCAD/render/*" "${ROOT}/src/render/*")
set(bad "")
foreach(f IN LISTS sources)
  file(STRINGS "${f}" lines REGEX "^[ \t]*#[ \t]*include[ \t]*[\"<]NiTCAD/")
  foreach(line IN LISTS lines)
    string(REGEX MATCH "NiTCAD/([a-z_]+)/" m "${line}")
    if(NOT CMAKE_MATCH_1 IN_LIST allowed)
      list(APPEND bad "${f}: ${line}")
    endif()
  endforeach()
endforeach()
list(LENGTH sources count)
if(count EQUAL 0)
  message(FATAL_ERROR "no render sources found under ${ROOT}")
endif()
if(bad)
  string(REPLACE ";" "\n" bad "${bad}")
  message(FATAL_ERROR "render includes a layer it may not depend on:\n${bad}")
endif()
message(STATUS "render layering: ${count} files, includes within ${allowed}")
