# WG6 (Unit 26): the app layer includes every layer except physics and assemble (ARCHITECTURE.md 3).
# Run as `cmake -DROOT=<source dir> -P layering.cmake`. The deck, solve and render headers it includes
# carry assemble's option types with them (the deck row of the table); the app's own files name none.
set(forbidden physics assemble)
file(GLOB_RECURSE sources "${ROOT}/include/NiTCAD/app/*" "${ROOT}/src/app/*" "${ROOT}/app/*")
set(bad "")
foreach(f IN LISTS sources)
  file(STRINGS "${f}" lines REGEX "^[ \t]*#[ \t]*include[ \t]*[\"<]NiTCAD/")
  foreach(line IN LISTS lines)
    string(REGEX MATCH "NiTCAD/([a-z_]+)/" m "${line}")
    if(CMAKE_MATCH_1 IN_LIST forbidden)
      list(APPEND bad "${f}: ${line}")
    endif()
  endforeach()
endforeach()
list(LENGTH sources count)
if(count EQUAL 0)
  message(FATAL_ERROR "no app sources found under ${ROOT}")
endif()
if(bad)
  string(REPLACE ";" "\n" bad "${bad}")
  message(FATAL_ERROR "app includes a layer it may not depend on:\n${bad}")
endif()
message(STATUS "app layering: ${count} files, no include of ${forbidden}")
