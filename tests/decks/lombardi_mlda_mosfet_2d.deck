# Unit 57 (DECISIONS.md GE1 iii, GG2): the 2D MOSFET example with Lombardi surface mobility (Unit 46)
# and MLDA quantum confinement (Unit 47), swept in the gate.

[mesh]
type = tensor
x = linspace(0, 2um, 41)
y = linspace(0, 0.9um, 19) + linspace(0.9um, 0.95um, 6) + linspace(0.95um, 1um, 3)

[region silicon]
material = silicon

[region oxide]
material = sio2
box = 0 2um  0.95um 1um

[doping]
profile = acceptor constant 1e16
profile = donor gaussian 2e19 axis=y center=0.95um width=0.15um x=0:0.5um lateral=20nm
profile = donor gaussian 2e19 axis=y center=0.95um width=0.15um x=1.5um:2um lateral=20nm

[contact source]
kind = ohmic
patch = x_min
box = 0 0  0.6um 0.94um

[contact drain]
kind = ohmic
patch = x_max
box = 2um 2um  0.6um 0.94um

[contact gate]
kind = electrode
patch = y_max
box = 0.5um 1.5um  1um 1um
electrode = metal
work_function = 4.1

[contact body]
kind = ohmic
patch = y_min

[models]
surface_mobility = lombardi
quantum_confinement = mlda

[sweep]
contact gate = 0 : 1.2 : 0.2
contact drain = 0.1

[output]
sweep = lombardi_mlda_mosfet_2d.nitsweep
device = lombardi_mlda_mosfet_2d.nitdev
table = lombardi_mlda_mosfet_2d.csv
