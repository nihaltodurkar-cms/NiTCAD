# 3D tri-gate n-channel FinFET on SOI
# A silicon fin 10 nm wide and 30 nm tall on a 20 nm buried oxide, wrapped on three sides by a high-k
# gate stack (0.5 nm SiO2 interfacial layer under 1.5 nm HfO2, EOT about 0.77 nm) and a 25 nm metal
# gate; nitride spacers beside the gate; n+ source and drain in the fin with a 3 nm underlap. The
# transfer curve Id-Vg in the linear regime (Vd = 50 mV); the Results tab gives V_th and the swing.
#
# Axes (nm): x along the fin, source (0) to drain (85), gate 30-55; y vertical: buried oxide 0-20,
# fin 20-50, interfacial 50-50.5, HfO2 50.5-52 (top gate at 52); z across the fin: HfO2 0-1.5,
# interfacial 1.5-2, fin 2-12, interfacial 12-12.5, HfO2 12.5-14 (side gates at z = 0 and 14).
#
# The gate is three electrode contacts (top, left, right) swept together; the side gates stop below
# y = 52 so no node belongs to two contacts.
#
# Mesh (medium, 22,011 nodes, half of a fine 45,000-node mesh): 2 nm under the gate and at
# the junctions, 5 nm in source and drain; 2 nm up the fin, 1 nm in its top 4 nm; 1 nm across it;
# 0.5 nm in the gate stack; every interface straddled. GMRES with ILUT (single thread) with step
# cutting; PARDISO on 6 threads with the MKL runtime is faster (see [solver]).
#
# Not predictive at this size: gate tunnelling and non-local transport are absent (ARCHITECTURE.md
# 11.3), and the mesh convergence is unchecked. Lombardi surface mobility (Unit 46) and MLDA quantum
# confinement (Unit 47) are available: on the fine 45,375-node mesh they lowered the 0.8 V current by
# 12% and 2.6%.

[device]
temperature = 300

[mesh]
type = tensor
x = linspace(0, 20nm, 5) + linspace(20nm, 65nm, 23) + linspace(65nm, 85nm, 5)
y = linspace(0, 20nm, 5) + linspace(20nm, 46nm, 14) + linspace(46nm, 50nm, 5) + linspace(50nm, 52nm, 5)
z = linspace(0, 2nm, 5) + linspace(2nm, 12nm, 11) + linspace(12nm, 14nm, 5)
straddle x = 30nm 0.5nm
straddle x = 55nm 0.5nm
straddle y = 20nm 0.5nm
straddle y = 50nm 0.2nm
straddle y = 50.5nm 0.2nm
straddle z = 1.5nm 0.2nm
straddle z = 2nm 0.2nm
straddle z = 12nm 0.2nm
straddle z = 12.5nm 0.2nm

# The background: the buried oxide (in practice y < 20 nm).
[region buried_oxide]
material = sio2

[region spacer]
material = insulator
eps_r = 7.5
box = 0 85nm  20nm 52nm  0 14nm

[region hfo2]
material = insulator
eps_r = 22
box = 30nm 55nm  20nm 52nm  0 14nm

[region interfacial]
material = sio2
box = 30nm 55nm  20nm 50.5nm  1.5nm 12.5nm

[region silicon]
material = silicon
box = 0 85nm  20nm 50nm  2nm 12nm

[doping]
profile = acceptor constant 1e16
profile = donor constant 1e20 axis=y x=-10nm:27nm lateral=2nm
profile = donor constant 1e20 axis=y x=58nm:95nm lateral=2nm

[contact source]
kind = ohmic
patch = x_min

[contact drain]
kind = ohmic
patch = x_max

[contact gate_top]
kind = electrode
patch = y_max
box = 30nm 55nm  52nm 52nm  0 14nm
electrode = metal
work_function = 4.4

[contact gate_left]
kind = electrode
patch = z_min
box = 30nm 55nm  20nm 51.9nm  0 0
electrode = metal
work_function = 4.4

[contact gate_right]
kind = electrode
patch = z_max
box = 30nm 55nm  20nm 51.9nm  14nm 14nm
electrode = metal
work_function = 4.4

[contact substrate]
kind = electrode
patch = y_min
electrode = metal
work_function = 4.6

[interface silicon interfacial]
fixed_charge = 5e10

[models]
fermi_dirac = on
field_mobility = on
electron_mobility = masetti

[solver]
backend = gmres_ilut
# With the MKL runtime instead:
# backend = pardiso
# mkl = <path to mkl_rt.3.dll>
# threads = 6
line_search = residual
max_cuts = 8

[sweep]
contact gate_top = 0 : 0.8 : 0.05
contact gate_left = 0 : 0.8 : 0.05
contact gate_right = 0 : 0.8 : 0.05
contact drain = 0.05

[output]
sweep = finfet_3d.nitsweep
device = finfet_3d.nitdev
table = finfet_3d.csv
