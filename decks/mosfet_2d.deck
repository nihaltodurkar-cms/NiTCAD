# 2D MOSFET
# An n-channel MOSFET in cross-section: the transfer curve Id-Vg at a drain bias of 50 mV.
#
# A 2 x 1 um silicon body (p-type, 1e17 cm^-3) under a 10 nm oxide, n+ source and drain (Gaussians
# of 1e20 cm^-3 in depth, windows along x), a 1 um metal gate (work function 4.1 eV, n+ poly-like),
# the body contact below. Threshold about 0.4 V. The Curves tab shows Id-Vg; the Results tab the
# threshold and the swing.
#
# Mesh (medium, 4,331 nodes): 20 nm along the channel, 50 nm in source and drain; 5 nm in the top
# 190 nm of silicon, 2 nm in the oxide, 50 nm deeper.

[mesh]
type = tensor
x = linspace(0, 0.5um, 11) + linspace(0.5um, 1.5um, 51) + linspace(1.5um, 2um, 11)
y = linspace(0, 0.8um, 17) + linspace(0.8um, 0.99um, 39) + linspace(0.99um, 1um, 6)
straddle y = 0.99um 0.5nm

[region silicon]
material = silicon

[region oxide]
material = sio2
box = 0 2um  0.99um 1um

[doping]
profile = acceptor constant 1e17
profile = donor gaussian 1e20 axis=y center=0.99um width=0.1um x=0:0.55um lateral=20nm
profile = donor gaussian 1e20 axis=y center=0.99um width=0.1um x=1.45um:2um lateral=20nm

[contact source]
kind = ohmic
patch = x_min
box = 0 0  0.8um 0.985um

[contact drain]
kind = ohmic
patch = x_max
box = 2um 2um  0.8um 0.985um

[contact gate]
kind = electrode
patch = y_max
box = 0.5um 1.5um  1um 1um
electrode = metal
work_function = 4.1

[contact body]
kind = ohmic
patch = y_min

[models]
field_mobility = on

[solver]
line_search = residual
max_cuts = 6

[sweep]
contact gate = 0 : 1.5 : 0.05
contact drain = 0.05

[output]
sweep = mosfet_2d.nitsweep
device = mosfet_2d.nitdev
table = mosfet_2d.csv
