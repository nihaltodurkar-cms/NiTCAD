# lesson: Source and drain doping
# track: intermediate
# order: 7
# step: The access regions
# Current reaches the channel through the source and drain. Lightly doped pockets have a high resistance in
# series with the channel, which costs current at high gate voltages where the channel itself conducts well.
# step: Sweep the source/drain doping
# Three source/drain dopings, from light to heavy, one transfer curve each.
# do: sweep Nsd = 1e18, 1e19, 1e20
# show: results
# report: Max transconductance, Threshold (max gm), On/off ratio
# step: What to see
# Compare the overlaid transfer curves in the Curves tab: with light source/drain doping the current bends
# over at high gate voltage, the series resistance taking a growing share of the drain bias. Heavily doped,
# shallow source and drain regions with low-resistance contacts are what processes aim for.
# show: curves

[parameters]
# group: Main
Lg = 1um  # Gate length
tox = 10nm  # Oxide thickness
Na = 1e17  # Body acceptors (cm^-3)
Nsd = 1e20  # Source/drain donors (cm^-3)
phi = 4.1  # Gate work function (eV)
# group: Biases
Vd = 0.05  # Drain bias (V)
Vg = 1.5  # Gate bias (V)
Vmax = 2  # Last bias of the swept contact (V)
# group: Body and contacts
Lsd = 0.5um  # Source/drain length
xj = 0.1um  # Junction depth
tsi = 0.99um  # Silicon depth
ov = 50nm  # Source/drain overlap under the gate
lat = 20nm  # Lateral spread of the source/drain
yc = 0.8um  # Contact bottom
gc = 5nm  # Contact gap below the oxide
nx = 51  # Mesh lines along the gate
# group: Positions (derived)
x_gate = $Lsd + $Lg  # Gate end
L = $Lsd + $Lg + $Lsd  # Device length
x_s = $Lsd + $ov  # Source window end
x_d = $Lsd + $Lg - $ov  # Drain window start
y_ox = $tsi + $tox  # Oxide top
y_ct = $tsi - $gc  # Contact top

[mesh]
type = tensor
x = linspace(0, $Lsd, 11) + linspace($Lsd, $x_gate, $nx) + linspace($x_gate, $L, 11)
y = linspace(0, $yc, 17) + linspace($yc, $tsi, 39) + linspace($tsi, $y_ox, 6)
straddle y = $tsi 0.5nm

[region silicon]
material = silicon

[region oxide]
material = sio2
box = 0 $L  $tsi $y_ox

[doping]
profile = acceptor constant $Na
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=0:$x_s lateral=$lat
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=$x_d:$L lateral=$lat

[contact source]
kind = ohmic
patch = x_min
box = 0 0  $yc $y_ct

[contact drain]
kind = ohmic
patch = x_max
box = $L $L  $yc $y_ct

[contact gate]
kind = electrode
patch = y_max
box = $Lsd $x_gate  $y_ox $y_ox
electrode = metal
work_function = $phi

[contact body]
kind = ohmic
patch = y_min

[models]
field_mobility = on
surface_mobility = off

[solver]
line_search = residual
max_cuts = 6

[sweep]
contact gate = 0 : $Vmax : 0.05
contact drain = $Vd

[output]
sweep = 07_source_drain_doping.nitsweep
device = 07_source_drain_doping.nitdev
table = 07_source_drain_doping.csv
