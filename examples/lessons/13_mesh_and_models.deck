# lesson: What the mesh and the models change
# track: advanced
# order: 13
# step: A number has an error bar
# Every figure a simulation gives depends on the mesh it was solved on and on the models chosen. Before
# trusting a number, refine the mesh until it stops moving. Here nx sets the mesh lines along the gate.
# step: Refine the mesh
# The same device on three meshes, each about twice as fine along the gate as the last.
# do: sweep nx = 26, 51, 101
# show: results
# report: Threshold (max gm), Subthreshold swing, Max transconductance
# step: What to see
# The coarsest mesh moves the figures; the two finer ones agree closely: the answer has converged in nx. Do
# the same for the mesh across the channel (the y lines near the oxide), and repeat the check whenever you
# change the device a lot.
#
# Models are a second error bar: the earlier lessons switched surface and field-dependent mobility. Quantum
# confinement (quantum_confinement in [models]) shifts Vth in thin oxides and films. Report which models and
# which mesh a number came from: NiTCAD writes both into every result file's run record.

[parameters]
# group: Main
Lg = 1um  # Gate length
tox = 10nm  # Oxide thickness
Na = 1e17  # Body acceptors (cm^-3)
Nsd = 1e20  # Source/drain donors (cm^-3)
phi = 4.1  # Gate work function (eV)
# group: Biases
Vd = 0.05  # Drain bias (V)
Vg = 1.5  # Gate bias (V)
Vmax = 2  # Last bias of the swept contact (V)
# group: Body and contacts
Lsd = 0.5um  # Source/drain length
xj = 0.1um  # Junction depth
tsi = 0.99um  # Silicon depth
ov = 50nm  # Source/drain overlap under the gate
lat = 20nm  # Lateral spread of the source/drain
yc = 0.8um  # Contact bottom
gc = 5nm  # Contact gap below the oxide
nx = 51  # Mesh lines along the gate
# group: Positions (derived)
x_gate = $Lsd + $Lg  # Gate end
L = $Lsd + $Lg + $Lsd  # Device length
x_s = $Lsd + $ov  # Source window end
x_d = $Lsd + $Lg - $ov  # Drain window start
y_ox = $tsi + $tox  # Oxide top
y_ct = $tsi - $gc  # Contact top

[mesh]
type = tensor
x = linspace(0, $Lsd, 11) + linspace($Lsd, $x_gate, $nx) + linspace($x_gate, $L, 11)
y = linspace(0, $yc, 17) + linspace($yc, $tsi, 39) + linspace($tsi, $y_ox, 6)
straddle y = $tsi 0.5nm

[region silicon]
material = silicon

[region oxide]
material = sio2
box = 0 $L  $tsi $y_ox

[doping]
profile = acceptor constant $Na
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=0:$x_s lateral=$lat
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=$x_d:$L lateral=$lat

[contact source]
kind = ohmic
patch = x_min
box = 0 0  $yc $y_ct

[contact drain]
kind = ohmic
patch = x_max
box = $L $L  $yc $y_ct

[contact gate]
kind = electrode
patch = y_max
box = $Lsd $x_gate  $y_ox $y_ox
electrode = metal
work_function = $phi

[contact body]
kind = ohmic
patch = y_min

[models]
field_mobility = on
surface_mobility = off

[solver]
line_search = residual
max_cuts = 6

[sweep]
contact gate = 0 : $Vmax : 0.05
contact drain = $Vd

[output]
sweep = 13_mesh_and_models.nitsweep
device = 13_mesh_and_models.nitdev
table = 13_mesh_and_models.csv
