# lesson: Subthreshold swing and the 60 mV/dec limit
# track: intermediate
# order: 5
# step: Below threshold
# Below Vth the channel carries a diffusion current that grows as exp(qψs / kT) with the surface
# potential ψs. The gate moves ψs only through a capacitive divider, Cox against the depletion
# capacitance Cdep, so the swing is SS = ln(10) · (kT/q) · (1 + Cdep / Cox): at 300 K, 60 mV/dec times a
# factor of at least one.
#
# No ordinary MOSFET switches more sharply than 60 mV per decade of current at room temperature; that limit
# sets how low the supply voltage of a chip can go.
# step: Sweep the doping, watch the swing
# More doping gives a thinner depletion layer and a larger Cdep, so a worse swing.
# do: sweep Na = 3e16, 1e17, 3e17
# show: results
# report: Subthreshold swing, Threshold (max gm)
# step: What to see
# Every value stays above 60 mV/dec, and the swing grows with Na. To approach the limit, make Cox large (a
# thin oxide) and Cdep small (a lightly doped body, or a thin fully depleted film as in SOI and FinFETs).
# Getting below it needs another mechanism: band-to-band tunnelling (the tunnel FET) or negative capacitance.

[parameters]
# group: Main
Lg = 1um  # Gate length
tox = 10nm  # Oxide thickness
Na = 1e17  # Body acceptors (cm^-3)
Nsd = 1e20  # Source/drain donors (cm^-3)
phi = 4.1  # Gate work function (eV)
# group: Biases
Vd = 0.05  # Drain bias (V)
Vg = 1.5  # Gate bias (V)
Vmax = 2  # Last bias of the swept contact (V)
# group: Body and contacts
Lsd = 0.5um  # Source/drain length
xj = 0.1um  # Junction depth
tsi = 0.99um  # Silicon depth
ov = 50nm  # Source/drain overlap under the gate
lat = 20nm  # Lateral spread of the source/drain
yc = 0.8um  # Contact bottom
gc = 5nm  # Contact gap below the oxide
nx = 51  # Mesh lines along the gate
# group: Positions (derived)
x_gate = $Lsd + $Lg  # Gate end
L = $Lsd + $Lg + $Lsd  # Device length
x_s = $Lsd + $ov  # Source window end
x_d = $Lsd + $Lg - $ov  # Drain window start
y_ox = $tsi + $tox  # Oxide top
y_ct = $tsi - $gc  # Contact top

[mesh]
type = tensor
x = linspace(0, $Lsd, 11) + linspace($Lsd, $x_gate, $nx) + linspace($x_gate, $L, 11)
y = linspace(0, $yc, 17) + linspace($yc, $tsi, 39) + linspace($tsi, $y_ox, 6)
straddle y = $tsi 0.5nm

[region silicon]
material = silicon

[region oxide]
material = sio2
box = 0 $L  $tsi $y_ox

[doping]
profile = acceptor constant $Na
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=0:$x_s lateral=$lat
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=$x_d:$L lateral=$lat

[contact source]
kind = ohmic
patch = x_min
box = 0 0  $yc $y_ct

[contact drain]
kind = ohmic
patch = x_max
box = $L $L  $yc $y_ct

[contact gate]
kind = electrode
patch = y_max
box = $Lsd $x_gate  $y_ox $y_ox
electrode = metal
work_function = $phi

[contact body]
kind = ohmic
patch = y_min

[models]
field_mobility = on
surface_mobility = off

[solver]
line_search = residual
max_cuts = 6

[sweep]
contact gate = 0 : $Vmax : 0.05
contact drain = $Vd

[output]
sweep = 05_subthreshold_swing.nitsweep
device = 05_subthreshold_swing.nitdev
table = 05_subthreshold_swing.csv
