# lesson: The gate and the channel
# track: basics
# order: 1
# step: A transistor in cross-section
# This is an n-channel MOSFET seen from the side: a p-type silicon body, two heavily doped n+ pockets (the
# source on the left, the drain on the right), a thin oxide on top and a metal gate over the channel between
# them. The Geometry tab shows each size as a named dimension.
#
# With no voltage on the gate, the p-type body between the two n+ pockets blocks electrons: two back-to-back
# pn junctions, and almost no drain current.
# show: geometry
# step: Turn the gate on
# A positive gate voltage pushes holes away from the surface (depletion) and, past the threshold voltage V_th,
# draws a thin layer of electrons to it: the inversion layer, an n-type channel joining source and drain.
#
# Run the transfer curve: the drain held at a small bias (Vd = 50 mV) while the gate sweeps from 0 to 2 V.
# do: run
# show: curves
# report: Threshold (max gm), Subthreshold swing, On/off ratio
# step: Reading the curve
# On a log axis the current rises exponentially below V_th (the subthreshold region), then bends over into a
# nearly linear rise above it. NiTCAD reads V_th where the transconductance g_m = dId/dVg peaks, extrapolated
# to zero current; the subthreshold swing is how many millivolts of gate voltage multiply the current by ten.
#
# Look at the electron density in the Fields tab at the last gate bias: the channel is a sheet a few
# nanometres thick under the oxide.
# show: fields

[parameters]
# group: Main
Lg = 1um  # Gate length
tox = 10nm  # Oxide thickness
Na = 1e17  # Body acceptors (cm^-3)
Nsd = 1e20  # Source/drain donors (cm^-3)
phi = 4.1  # Gate work function (eV)
# group: Biases
Vd = 0.05  # Drain bias (V)
Vg = 1.5  # Gate bias (V)
Vmax = 2  # Last bias of the swept contact (V)
# group: Body and contacts
Lsd = 0.5um  # Source/drain length
xj = 0.1um  # Junction depth
tsi = 0.99um  # Silicon depth
ov = 50nm  # Source/drain overlap under the gate
lat = 20nm  # Lateral spread of the source/drain
yc = 0.8um  # Contact bottom
gc = 5nm  # Contact gap below the oxide
nx = 51  # Mesh lines along the gate
# group: Positions (derived)
x_gate = $Lsd + $Lg  # Gate end
L = $Lsd + $Lg + $Lsd  # Device length
x_s = $Lsd + $ov  # Source window end
x_d = $Lsd + $Lg - $ov  # Drain window start
y_ox = $tsi + $tox  # Oxide top
y_ct = $tsi - $gc  # Contact top

[mesh]
type = tensor
x = linspace(0, $Lsd, 11) + linspace($Lsd, $x_gate, $nx) + linspace($x_gate, $L, 11)
y = linspace(0, $yc, 17) + linspace($yc, $tsi, 39) + linspace($tsi, $y_ox, 6)
straddle y = $tsi 0.5nm

[region silicon]
material = silicon

[region oxide]
material = sio2
box = 0 $L  $tsi $y_ox

[doping]
profile = acceptor constant $Na
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=0:$x_s lateral=$lat
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=$x_d:$L lateral=$lat

[contact source]
kind = ohmic
patch = x_min
box = 0 0  $yc $y_ct

[contact drain]
kind = ohmic
patch = x_max
box = $L $L  $yc $y_ct

[contact gate]
kind = electrode
patch = y_max
box = $Lsd $x_gate  $y_ox $y_ox
electrode = metal
work_function = $phi

[contact body]
kind = ohmic
patch = y_min

[models]
field_mobility = on
surface_mobility = off

[solver]
line_search = residual
max_cuts = 6

[sweep]
contact gate = 0 : $Vmax : 0.05
contact drain = $Vd

[output]
sweep = 01_gate_and_channel.nitsweep
device = 01_gate_and_channel.nitdev
table = 01_gate_and_channel.csv
