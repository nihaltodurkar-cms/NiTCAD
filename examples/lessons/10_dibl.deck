# lesson: Drain-induced barrier lowering
# track: advanced
# order: 10
# step: The source barrier
# Electrons leave the source over a potential barrier the gate controls. In a short channel the drain's
# field lowers that barrier too, so a higher drain voltage turns the transistor on earlier: drain-induced
# barrier lowering, DIBL, quoted as the threshold shift per volt of drain bias, -dV_th/dVd in mV/V.
#
# This device has a 0.25 um gate.
# step: Sweep the drain bias
# Three transfer curves, from a small drain bias to 1 V.
# do: sweep Vd = 0.05, 0.5, 1
# show: results
# report: Threshold (max gm), Subthreshold swing
# step: What to see
# V_th falls as Vd rises. Take DIBL from the first and last values: (V_th at 0.05 V - V_th at 1 V) / 0.95 V.
# Industry quotes it from a constant-current threshold; NiTCAD reads V_th at the peak transconductance, so
# compare devices with one method. Try Lg = 1um in the Geometry panel and sweep again: the shift shrinks in
# a long channel.

[parameters]
# group: Main
Lg = 0.25um  # Gate length
tox = 10nm  # Oxide thickness
Na = 1e17  # Body acceptors (cm^-3)
Nsd = 1e20  # Source/drain donors (cm^-3)
phi = 4.1  # Gate work function (eV)
# group: Biases
Vd = 0.05  # Drain bias (V)
Vg = 1.5  # Gate bias (V)
Vmax = 2  # Last bias of the swept contact (V)
# group: Body and contacts
Lsd = 0.5um  # Source/drain length
xj = 0.1um  # Junction depth
tsi = 0.99um  # Silicon depth
ov = 50nm  # Source/drain overlap under the gate
lat = 20nm  # Lateral spread of the source/drain
yc = 0.8um  # Contact bottom
gc = 5nm  # Contact gap below the oxide
nx = 51  # Mesh lines along the gate
# group: Positions (derived)
x_gate = $Lsd + $Lg  # Gate end
L = $Lsd + $Lg + $Lsd  # Device length
x_s = $Lsd + $ov  # Source window end
x_d = $Lsd + $Lg - $ov  # Drain window start
y_ox = $tsi + $tox  # Oxide top
y_ct = $tsi - $gc  # Contact top

[mesh]
type = tensor
x = linspace(0, $Lsd, 11) + linspace($Lsd, $x_gate, $nx) + linspace($x_gate, $L, 11)
y = linspace(0, $yc, 17) + linspace($yc, $tsi, 39) + linspace($tsi, $y_ox, 6)
straddle y = $tsi 0.5nm

[region silicon]
material = silicon

[region oxide]
material = sio2
box = 0 $L  $tsi $y_ox

[doping]
profile = acceptor constant $Na
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=0:$x_s lateral=$lat
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=$x_d:$L lateral=$lat

[contact source]
kind = ohmic
patch = x_min
box = 0 0  $yc $y_ct

[contact drain]
kind = ohmic
patch = x_max
box = $L $L  $yc $y_ct

[contact gate]
kind = electrode
patch = y_max
box = $Lsd $x_gate  $y_ox $y_ox
electrode = metal
work_function = $phi

[contact body]
kind = ohmic
patch = y_min

[models]
field_mobility = on
surface_mobility = off

[solver]
line_search = residual
max_cuts = 6

[sweep]
contact gate = 0 : $Vmax : 0.05
contact drain = $Vd

[output]
sweep = 10_dibl.nitsweep
device = 10_dibl.nitdev
table = 10_dibl.csv
