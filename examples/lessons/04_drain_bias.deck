# lesson: Drain bias: the linear and saturation regions
# track: basics
# order: 4
# step: The output curve
# So far the drain sat at 50 mV. Now the gate is held fixed and the drain is swept from 0 to 2 V: the output
# characteristic Id-Vd, one curve per gate voltage.
#
# At small Vd the channel is a resistor and Id grows linearly. As Vd approaches Vg - V_th the channel near
# the drain thins away (pinch-off) and the current levels off: saturation, Id_sat = (W/2L) mu C_ox
# (Vg - V_th)^2 in the long-channel model.
# step: A family of curves
# One output curve per gate voltage, overlaid in the Curves tab.
# do: sweep Vg = 1, 1.5, 2
# show: curves
# report: Current at the last bias
# step: What to see
# Each curve rises, then flattens. A higher gate voltage gives a larger saturation current, roughly with the
# square of the overdrive Vg - V_th. The current is per unit width (A/cm): a 2D cross-section stands for a
# device of any width.
#
# In the Fields tab, look at the electron density at the last drain bias: the channel thins towards the drain.
# show: fields

[parameters]
# group: Main
Lg = 1um  # Gate length
tox = 10nm  # Oxide thickness
Na = 1e17  # Body acceptors (cm^-3)
Nsd = 1e20  # Source/drain donors (cm^-3)
phi = 4.1  # Gate work function (eV)
# group: Biases
Vd = 0.05  # Drain bias (V)
Vg = 1.5  # Gate bias (V)
Vmax = 2  # Last bias of the swept contact (V)
# group: Body and contacts
Lsd = 0.5um  # Source/drain length
xj = 0.1um  # Junction depth
tsi = 0.99um  # Silicon depth
ov = 50nm  # Source/drain overlap under the gate
lat = 20nm  # Lateral spread of the source/drain
yc = 0.8um  # Contact bottom
gc = 5nm  # Contact gap below the oxide
nx = 51  # Mesh lines along the gate
# group: Positions (derived)
x_gate = $Lsd + $Lg  # Gate end
L = $Lsd + $Lg + $Lsd  # Device length
x_s = $Lsd + $ov  # Source window end
x_d = $Lsd + $Lg - $ov  # Drain window start
y_ox = $tsi + $tox  # Oxide top
y_ct = $tsi - $gc  # Contact top

[mesh]
type = tensor
x = linspace(0, $Lsd, 11) + linspace($Lsd, $x_gate, $nx) + linspace($x_gate, $L, 11)
y = linspace(0, $yc, 17) + linspace($yc, $tsi, 39) + linspace($tsi, $y_ox, 6)
straddle y = $tsi 0.5nm

[region silicon]
material = silicon

[region oxide]
material = sio2
box = 0 $L  $tsi $y_ox

[doping]
profile = acceptor constant $Na
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=0:$x_s lateral=$lat
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=$x_d:$L lateral=$lat

[contact source]
kind = ohmic
patch = x_min
box = 0 0  $yc $y_ct

[contact drain]
kind = ohmic
patch = x_max
box = $L $L  $yc $y_ct

[contact gate]
kind = electrode
patch = y_max
box = $Lsd $x_gate  $y_ox $y_ox
electrode = metal
work_function = $phi

[contact body]
kind = ohmic
patch = y_min

[models]
field_mobility = on
surface_mobility = off

[solver]
line_search = residual
max_cuts = 6

[sweep]
contact drain = 0 : $Vmax : 0.1
contact gate = $Vg

[output]
sweep = 04_drain_bias.nitsweep
device = 04_drain_bias.nitdev
table = 04_drain_bias.csv
