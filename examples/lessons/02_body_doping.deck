# lesson: Body doping and the threshold voltage
# track: basics
# order: 2
# step: What the body doping does
# Before a channel can form, the gate must deplete the body under it: push the holes away and uncover the
# fixed acceptor ions. More acceptors (a larger Na) means more charge to uncover and a stronger field needed
# to bend the bands to inversion, so the threshold voltage rises.
#
# The textbook relation: V_th = V_fb + 2 phi_F + sqrt(2 q eps_Si Na 2 phi_F) / C_ox, with phi_F the Fermi
# potential of the body (it grows as ln Na) and C_ox = eps_ox / tox the oxide capacitance per area.
# step: Sweep the doping
# Three runs, one per body doping, each a full transfer curve. The Results tab plots each figure against Na.
# do: sweep Na = 3e16, 1e17, 3e17
# show: results
# report: Threshold (max gm), Subthreshold swing
# step: What to see
# V_th rises with Na: the depletion charge grows as sqrt(Na) and phi_F as ln Na. The swing rises too, since a
# thinner depletion layer couples the surface more strongly to the body (see the swing lesson).
#
# Doping is the main knob a process uses to set V_th; the price of a high Na is a lower mobility (more
# impurity scattering) and a worse swing.

[parameters]
# group: Main
Lg = 1um  # Gate length
tox = 10nm  # Oxide thickness
Na = 1e17  # Body acceptors (cm^-3)
Nsd = 1e20  # Source/drain donors (cm^-3)
phi = 4.1  # Gate work function (eV)
# group: Biases
Vd = 0.05  # Drain bias (V)
Vg = 1.5  # Gate bias (V)
Vmax = 2  # Last bias of the swept contact (V)
# group: Body and contacts
Lsd = 0.5um  # Source/drain length
xj = 0.1um  # Junction depth
tsi = 0.99um  # Silicon depth
ov = 50nm  # Source/drain overlap under the gate
lat = 20nm  # Lateral spread of the source/drain
yc = 0.8um  # Contact bottom
gc = 5nm  # Contact gap below the oxide
nx = 51  # Mesh lines along the gate
# group: Positions (derived)
x_gate = $Lsd + $Lg  # Gate end
L = $Lsd + $Lg + $Lsd  # Device length
x_s = $Lsd + $ov  # Source window end
x_d = $Lsd + $Lg - $ov  # Drain window start
y_ox = $tsi + $tox  # Oxide top
y_ct = $tsi - $gc  # Contact top

[mesh]
type = tensor
x = linspace(0, $Lsd, 11) + linspace($Lsd, $x_gate, $nx) + linspace($x_gate, $L, 11)
y = linspace(0, $yc, 17) + linspace($yc, $tsi, 39) + linspace($tsi, $y_ox, 6)
straddle y = $tsi 0.5nm

[region silicon]
material = silicon

[region oxide]
material = sio2
box = 0 $L  $tsi $y_ox

[doping]
profile = acceptor constant $Na
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=0:$x_s lateral=$lat
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=$x_d:$L lateral=$lat

[contact source]
kind = ohmic
patch = x_min
box = 0 0  $yc $y_ct

[contact drain]
kind = ohmic
patch = x_max
box = $L $L  $yc $y_ct

[contact gate]
kind = electrode
patch = y_max
box = $Lsd $x_gate  $y_ox $y_ox
electrode = metal
work_function = $phi

[contact body]
kind = ohmic
patch = y_min

[models]
field_mobility = on
surface_mobility = off

[solver]
line_search = residual
max_cuts = 6

[sweep]
contact gate = 0 : $Vmax : 0.05
contact drain = $Vd

[output]
sweep = 02_body_doping.nitsweep
device = 02_body_doping.nitdev
table = 02_body_doping.csv
