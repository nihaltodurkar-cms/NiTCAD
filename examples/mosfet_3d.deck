# 3D MOSFET
# An n-channel MOSFET in 3D: a gate sweep at a drain bias of 0.5 V, its fields on the device.
#
# A 2 x 1 x 0.8 um silicon body (p-type, 1e16 cm^-3) under a 50 nm oxide, n+ source and drain pockets,
# a metal gate over the channel across the width. Look at the potential and the electrons in 3D, cut
# with a slice plane (Device view, View: slice) or a clipping box.

[mesh]
type = tensor
x = linspace(0, 2um, 21)
y = linspace(0, 0.9um, 10) + linspace(0.9um, 0.95um, 3) + linspace(0.95um, 1um, 2)
z = linspace(0, 0.8um, 7)

[region silicon]
material = silicon

[region oxide]
material = sio2
box = 0 2um  0.95um 1um  0 0.8um

[doping]
profile = acceptor constant 1e16
profile = donor gaussian 2e19 axis=y center=0.95um width=0.15um x=0:0.5um lateral=20nm
profile = donor gaussian 2e19 axis=y center=0.95um width=0.15um x=1.5um:2um lateral=20nm

[contact source]
kind = ohmic
patch = x_min
box = 0 0  0.6um 0.94um  0 0.8um

[contact drain]
kind = ohmic
patch = x_max
box = 2um 2um  0.6um 0.94um  0 0.8um

[contact gate]
kind = electrode
patch = y_max
box = 0.5um 1.5um  1um 1um  0 0.8um
electrode = metal
work_function = 4.1

[contact body]
kind = ohmic
patch = y_min

[sweep]
contact gate = 0 : 1.2 : 0.3
contact drain = 0.5

[output]
sweep = mosfet_3d.nitsweep
device = mosfet_3d.nitdev
table = mosfet_3d.csv
