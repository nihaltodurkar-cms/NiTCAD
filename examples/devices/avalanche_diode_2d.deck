# Avalanche diode (2D)
# A p+/n silicon diode in cross-section driven into reverse breakdown by impact ionization: the avalanche I-V.
#
# An n-type layer with a p+ diffusion (a Gaussian from the top face) under an anode window; the cathode is the
# whole bottom face. In reverse the depletion region widens into the n layer until carriers gain enough energy to
# ionize silicon atoms; each new pair is accelerated too and the current multiplies without bound at the breakdown
# voltage. Lighter n doping, higher breakdown.
# Change a dimension in the Geometry tab's panel; run it (F5), then look at the reverse I-V and the field (Curves).

[parameters]
# group: Main
D = 4um  # Silicon depth
W = 3um  # Width
Wa = 2um  # Anode window width
Nd = 1e17  # n layer donors (cm^-3)
Na = 1e19  # p+ diffusion acceptors (cm^-3)
xj = 0.3um  # p+ diffusion depth (Gaussian width)
# group: Diffusion and mesh
lat = 0.1um  # Lateral spread of the diffusion
Df = 1.5um  # Fine-mesh depth from the top
# group: Positions (derived)
y_f = $D - $Df  # Fine mesh start
x_lo = 0 - $W  # Diffusion window start (past the edge)

[mesh]
type = tensor
x = linspace(0, $Wa, 21) + linspace($Wa, $W, 21)
y = linspace(0, $y_f, 21) + linspace($y_f, $D, 61)

[region silicon]
material = silicon

[doping]
profile = donor constant $Nd
profile = acceptor gaussian $Na axis=y center=$D width=$xj x=$x_lo:$Wa lateral=$lat

[contact anode]
kind = ohmic
patch = y_max
box = 0 $Wa  $D $D

[contact cathode]
kind = ohmic
patch = y_min

[models]
impact_ionization = on

[solver]
line_search = residual
max_cuts = 8

[sweep]
contact anode = 0 : -15 : -0.5

[output]
sweep = avalanche_diode_2d.nitsweep
device = avalanche_diode_2d.nitdev
table = avalanche_diode_2d.csv
