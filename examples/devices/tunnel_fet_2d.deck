# Tunnel FET (2D)
# A double-gate silicon tunnel FET in cross-section: p+ source, intrinsic channel, n+ drain; Id-Vg at 0.5 V.
#
# A thin film between a top and a bottom gate (tied together), with a p+ source and an n+ drain: a gated p-i-n
# diode in reverse. The gates pull the channel's conduction band down until it lines up with the source's valence
# band and electrons tunnel across the source junction (Kane nonlocal band-to-band tunnelling), so the current is
# switched by tunnelling, not by thermionic emission over a barrier as in a MOSFET. Change a dimension in the
# Geometry tab's panel; run it (F5), then look at the transfer curve (Curves) and the generation rate at the source.

[parameters]
# group: Main
Lg = 30nm  # Gate length
tsi = 10nm  # Silicon film thickness
tox = 1nm  # Gate oxide thickness (each)
Na = 1e15  # Channel acceptors (cm^-3)
Ns = 1e20  # Source acceptors (cm^-3)
Nd = 5e18  # Drain donors (cm^-3)
# group: Source and drain
Lsd = 30nm  # Source/drain length (each)
lat = 1nm  # Lateral spread of the source/drain
# group: Positions (derived)
x_gate = $Lsd + $Lg  # Gate end
L = $Lsd + $Lg + $Lsd  # Device length
x_lo = 0 - $L  # Source window start (past the end)
x_hi = $L + $L  # Drain window end (past the end)
y_si = $tox + $tsi  # Film top
y_ox = $tox + $tsi + $tox  # Top oxide top

[mesh]
type = tensor
x = linspace(0, $Lsd, 11) + linspace($Lsd, $x_gate, 31) + linspace($x_gate, $L, 11)
y = linspace(0, $tox, 4) + linspace($tox, $y_si, 21) + linspace($y_si, $y_ox, 4)
straddle y = $tox 0.1nm
straddle y = $y_si 0.1nm

[region silicon]
material = silicon

[region bottom_oxide]
material = sio2
box = 0 $L  0 $tox

[region top_oxide]
material = sio2
box = 0 $L  $y_si $y_ox

[doping]
profile = acceptor constant $Na
profile = acceptor constant $Ns x=$x_lo:$Lsd lateral=$lat
profile = donor constant $Nd x=$x_gate:$x_hi lateral=$lat

[contact source]
kind = ohmic
patch = x_min
box = 0 0  $tox $y_si

[contact drain]
kind = ohmic
patch = x_max
box = $L $L  $tox $y_si

[contact gate_top]
kind = electrode
patch = y_max
box = $Lsd $x_gate  $y_ox $y_ox
electrode = metal
work_function = 4.0

[contact gate_bottom]
kind = electrode
patch = y_min
box = $Lsd $x_gate  0 0
electrode = metal
work_function = 4.0

[models]
fermi_dirac = on
btbt_nonlocal = kane
field_mobility = on

[solver]
line_search = residual
max_cuts = 8

[sweep]
contact gate_top = 0 : 1.5 : 0.05
contact gate_bottom = 0 : 1.5 : 0.05
contact drain = 0.5

[output]
sweep = tunnel_fet_2d.nitsweep
device = tunnel_fet_2d.nitdev
table = tunnel_fet_2d.csv
