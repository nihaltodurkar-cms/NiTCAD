# Planar MOSFET (2D)
# An n-channel MOSFET in cross-section, every size a named dimension: the transfer curve Id-Vg at 50 mV.
#
# A p-type silicon body under a thin oxide, n+ source and drain (Gaussians in depth under the surface, windows
# along x reaching under the gate by the overlap), a metal gate (work function 4.1 eV) over the channel, the
# body contact below. The mesh lines follow the dimensions: 20 nm along the channel at the defaults, 5 nm in
# the top of the silicon, 2 nm in the oxide. The Curves tab shows Id-Vg; the Results tab the threshold and swing.

[parameters]
# group: Main
Lg = 1um  # Gate length
tox = 10nm  # Oxide thickness
Lsd = 0.5um  # Source/drain length
xj = 0.1um  # Junction depth
Na = 1e17  # Body acceptors (cm^-3)
Nsd = 1e20  # Source/drain donors (cm^-3)
# group: Body and contacts
tsi = 0.99um  # Silicon depth
ov = 50nm  # Source/drain overlap under the gate
lat = 20nm  # Lateral spread of the source/drain
yc = 0.8um  # Contact bottom
gc = 5nm  # Contact gap below the oxide
# group: Positions (derived)
x_gate = $Lsd + $Lg  # Gate end
L = $Lsd + $Lg + $Lsd  # Device length
x_s = $Lsd + $ov  # Source window end
x_d = $Lsd + $Lg - $ov  # Drain window start
y_ox = $tsi + $tox  # Oxide top
y_ct = $tsi - $gc  # Contact top

[mesh]
type = tensor
x = linspace(0, $Lsd, 11) + linspace($Lsd, $x_gate, 51) + linspace($x_gate, $L, 11)
y = linspace(0, $yc, 17) + linspace($yc, $tsi, 39) + linspace($tsi, $y_ox, 6)
straddle y = $tsi 0.5nm

[region silicon]
material = silicon

[region oxide]
material = sio2
box = 0 $L  $tsi $y_ox

[doping]
profile = acceptor constant $Na
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=0:$x_s lateral=$lat
profile = donor gaussian $Nsd axis=y center=$tsi width=$xj x=$x_d:$L lateral=$lat

[contact source]
kind = ohmic
patch = x_min
box = 0 0  $yc $y_ct

[contact drain]
kind = ohmic
patch = x_max
box = $L $L  $yc $y_ct

[contact gate]
kind = electrode
patch = y_max
box = $Lsd $x_gate  $y_ox $y_ox
electrode = metal
work_function = 4.1

[contact body]
kind = ohmic
patch = y_min

[models]
field_mobility = on

[solver]
line_search = residual
max_cuts = 6

[sweep]
contact gate = 0 : 1.5 : 0.05
contact drain = 0.05

[output]
sweep = mosfet_2d.nitsweep
device = mosfet_2d.nitdev
table = mosfet_2d.csv
