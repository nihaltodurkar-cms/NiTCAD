+// Unit 41 measurement only (not committed): Eigen SparseLU cost and result bits on the MOSFET's
+// and a 20^3 3D diode's Jacobians, under whatever cache sizes the process uses (NITCAD_EIGEN_CACHE).
+namespace {
+unsigned long long bits_hash(const std::vector<double>& x) {
+    unsigned long long h = 0xcbf29ce484222325ull;
+    for (const double v : x) {
+        const auto b = std::bit_cast<unsigned long long>(v);
+        for (int k = 0; k < 8; ++k) {
+            h ^= (b >> (8 * k)) & 0xffu;
+            h *= 0x100000001b3ull;
+        }
+    }
+    return h;
+}
+}  // namespace
+
+TEST_CASE("unit41: Eigen SparseLU cost", "[.unit41_cost]") {
+    {
+        const device::Device d = mosfet();
+        const auto eq = *solve::solve_equilibrium(d);
+        std::vector<double> rhs;
+        const linalg::SparseMatrix j = device_jacobian(
+            d, std::vector<double>{0.0, 0.05, 0.0, 1.0}, eq.fields.potential_V, rhs);
+        const SolverTiming t = time_solver(j, rhs, {}, 5);
+        std::printf("unit41 mosfet (%zu unknowns): first %.2f ms refactor %.2f ms solve %.3f ms "
+                    "x %016llx\n",
+                    static_cast<std::size_t>(j.rows()), 1e3 * t.first_s, 1e3 * t.refactor_s,
+                    1e3 * t.solve_s, bits_hash(t.x));
+    }
+    {
+        std::vector<double> a(20), b(20);
+        for (int i = 0; i < 20; ++i) {
+            a[static_cast<std::size_t>(i)] = 2e-4 * i / 19.0;
+            b[static_cast<std::size_t>(i)] = 1e-4 * i / 19.0;
+        }
+        mesh::Mesh m = *mesh::make_tensor_grid(a, b, b);
+        const std::size_t n = m.node_count();
+        std::vector<double> donors(n, 0.0), acceptors(n, 0.0);
+        for (std::size_t i = 0; i < n; ++i) {
+            (m.points()[i][0] < 1e-4 ? acceptors : donors)[i] = 1e17;
+        }
+        auto anode = m.find_boundary("x_min")->nodes;
+        auto cathode = m.find_boundary("x_max")->nodes;
+        const device::Device d = *device::Device::create(
+            {.mesh = std::move(m),
+             .temperature_K = 300.0,
+             .regions = {{"silicon", physics::silicon()}},
+             .node_region = std::vector<device::RegionId>(n, 0),
+             .donors = std::move(donors),
+             .acceptors = std::move(acceptors),
+             .contacts = {{"anode", device::ContactKind::ohmic, std::move(anode)},
+                          {"cathode", device::ContactKind::ohmic, std::move(cathode)}}});
+        const auto eq = *solve::solve_equilibrium(d);
+        std::vector<double> rhs;
+        const linalg::SparseMatrix j =
+            device_jacobian(d, std::vector<double>{0.5, 0.0}, eq.fields.potential_V, rhs);
+        const SolverTiming t = time_solver(j, rhs, {}, 3);
+        std::printf("unit41 3D diode 20^3 (%zu unknowns): first %.1f ms refactor %.1f ms solve "
+                    "%.2f ms x %016llx\n",
+                    static_cast<std::size_t>(j.rows()), 1e3 * t.first_s, 1e3 * t.refactor_s,
+                    1e3 * t.solve_s, bits_hash(t.x));
+    }
+}
